// Local is what has been run. The batch profile is the shape the AWS deployment takes; it needs a GPU
// queue and an image with ProteinMPNN's weights, neither of which is provisioned yet.
profiles {
    local {
        process.executor = 'local'
        process.cpus = 2
        params.python = "${projectDir}/../../.venv/bin/python"
        env.PROTEINMPNN = "${projectDir}/../../data/tools/proteinmpnn"
    }
    batch {
        process.executor = 'awsbatch'
        process.queue = 'qafi-dev-design'
        aws.region = 'eu-central-1'
        process.container = 'qafi/design:latest'
        withLabel: gpu { accelerator = 1 }
    }
}
