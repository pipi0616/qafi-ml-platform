// Deep mutational scanning reads -> fitness (notebook 14b).
//   nextflow run pipelines/dms_fitness -profile docker -params-file pipelines/dms_fitness/experiments/<x>.yaml

manifest {
    name            = 'qafi/dms_fitness'
    description     = 'DMS sequencing reads to variant fitness: FastQC, MultiQC and DiMSum'
    nextflowVersion = '>=24.04'
}

params {
    samplesheet = null    // csv: the DiMSum design columns plus fastq_1, fastq_2 (file names)
    fastq_dir   = null    // where those files are: a local folder (or s3://... with AWS credentials)
    outdir      = 'results'
    name        = 'dms'

    // DiMSum settings: every one is set per experiment in experiments/<x>.yaml
    wildtype                    = null
    cutadapt5_first             = null
    cutadapt5_second            = null
    cutadapt_min_length         = 200
    cutadapt_error_rate         = 0.2
    vsearch_min_qual            = 25
    vsearch_maxee               = 0.25
    mutagenesis_type            = 'codon'
    background_codons           = ''     // nicking libraries: keep doubles built on these codons only
    fitness_min_input_count_any = ''
    // DiMSum splits every FASTQ into chunks and filters them in parallel workers; smaller chunks keep a
    // laptop's memory in bounds and change no count (the chunks are added up). DiMSum's default is 3.5 GB.
    split_chunk_size            = 30000000
}

// Every tool runs in a pinned container from BioContainers, the bioconda project's images, so the
// versions are exactly the ones named here on any machine. DiMSum 1.2.8 is the version the paper used.
process {
    cpus   = 1
    memory = '1 GB'
    withName: FASTQC {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        cpus      = 2
        memory    = '1.5 GB'
    }
    withName: MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
        memory    = '2 GB'
    }
    withName: 'DIMSUM_.*|KEEP_DESIGNED_DOUBLES' {
        container = 'quay.io/biocontainers/r-dimsum:1.2.8--r41hdfd78af_0'
    }
    // Measured on this Mac, two memory peaks per DiMSum worker:
    //   splitting a full MiSeq FASTQ into chunks: about 1.7 GB, whatever the chunk size;
    //   filtering merged reads: about 25 times the chunk (2.4 GB for a 96 MB chunk), because per-base
    //   qualities are expanded into a matrix, hence the 30 MB chunks (split_chunk_size).
    // With 6 or 3 workers the kernel killed a worker for lack of memory; 2 workers stay inside 5 GB.
    withName: 'DIMSUM_.*' {
        cpus   = 2
        memory = '5 GB'
    }
}

profiles {
    docker {
        docker.enabled    = true
        // BioContainers images are built for x86; on an Apple-silicon Mac, Docker runs them through Rosetta.
        docker.runOptions = '--platform linux/amd64'
        executor.cpus     = 6
        executor.memory   = '6 GB'    // what the Docker VM can spare: Nextflow never schedules beyond it
    }
    // Every step a job on AWS Batch (infra/dev/batch.tf): x86 Spot machines with 2 vCPUs, 8 GB and a
    // 100 GB disk, started when jobs wait and stopped when the queue is empty. Inputs, the work folder
    // and the results are all on S3. The laptop only orchestrates. DiMSum keeps the laptop's 2 workers
    // and 30 MB chunks, measured at about 4 GB, and gets the machine's memory minus what ECS keeps.
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'qafi-dev-pipelines'
        aws.region        = 'eu-central-1'
        aws.batch.cliPath = '/opt/awscli/bin/aws'   // a conda environment the launch template installs
        process {
            withName: 'DIMSUM_.*' {
                cpus   = 2
                memory = '6 GB'
            }
        }
    }
}

// A record of every run: what ran, how long, how much memory. Kept with the results.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
